{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["origin", "company", "image", "persistence", "networkPolicy"],
  "properties": {
    "origin": {"type": "string", "pattern": "^https://[^/]+$"},
    "company": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["storageClass", "size"],
      "properties": {
        "storageClass": {"type": "string", "minLength": 1},
        "size": {"type": "string", "pattern": "^[1-9][0-9]*Gi$"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["ingressCidrs"],
      "properties": {
        "ingressCidrs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "additionalPaths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "pathType", "backend"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "pathType": {"type": "string", "enum": ["Prefix", "Exact"]},
              "backend": {"type": "object"}
            }
          }
        }
      }
    },
    "application": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    }
  }
}
