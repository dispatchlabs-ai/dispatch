{
  "name": "@dispatch/fleet",
  "version": "0.8.0",
  "private": true,
  "description": "Host-owned durable agent execution on replaceable workers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./relay": {
      "types": "./dist/relay-server.d.ts",
      "import": "./dist/relay-server.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dispatch/runner": "0.8.0",
    "@dispatch/slack": "0.8.0",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
