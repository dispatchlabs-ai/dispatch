{
  "name": "@dispatch/fleet",
  "version": "0.17.1",
  "description": "Host-owned durable agent execution on replaceable workers",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./relay": {
      "types": "./dist/relay-server.d.ts",
      "import": "./dist/relay-server.js"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "import": "./dist/slack.js"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dispatch/runner": "0.17.1",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispatchlabs-ai/dispatch.git",
    "directory": "packages/fleet"
  },
  "homepage": "https://github.com/dispatchlabs-ai/dispatch/tree/main/packages/fleet#readme",
  "bugs": {
    "url": "https://github.com/dispatchlabs-ai/dispatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@dispatch/slack": "0.17.1"
  },
  "peerDependenciesMeta": {
    "@dispatch/slack": {
      "optional": true
    }
  }
}
