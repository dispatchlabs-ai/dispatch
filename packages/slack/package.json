{
  "name": "@dispatch/slack",
  "version": "0.11.2",
  "private": true,
  "description": "Slack transport for Dispatch Runner",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace @dispatch/runner",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@slack/socket-mode": "3.1.0",
    "@slack/web-api": "8.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@dispatch/runner": "0.11.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/chord": "1.5.2"
  }
}
