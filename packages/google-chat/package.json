    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@dispatch/runner": "0.17.3",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/chord": "1.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispatchlabs-ai/dispatch.git",
    "directory": "packages/google-chat"
  },
  "homepage": "https://github.com/dispatchlabs-ai/dispatch/tree/main/packages/google-chat#readme",
  "bugs": {
    "url": "https://github.com/dispatchlabs-ai/dispatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
