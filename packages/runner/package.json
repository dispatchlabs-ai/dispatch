{
  "name": "@dispatch/runner",
  "version": "0.19.0",
  "description": "Standalone Pi Durable company agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./watch-reader": {
      "types": "./dist/watch-reader.d.ts",
      "import": "./dist/watch-reader.js"
    },
    "./host-models": {
      "types": "./dist/host-models.d.ts",
      "import": "./dist/host-models.js"
    },
    "./environment-provider": {
      "types": "./dist/environment-provider.d.ts",
      "import": "./dist/environment-provider.js"
    },
    "./local-provider": {
      "types": "./dist/local-provider.d.ts",
      "import": "./dist/local-provider.js"
    },
    "./settings": {
      "types": "./dist/settings.d.ts",
      "import": "./dist/settings.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./records": {
      "types": "./dist/records.d.ts",
      "import": "./dist/records.js"
    }
  },
  "bin": {
    "dispatch": "./dist/agent-cli.js",
    "dispatch-agent": "./dist/agent-cli.js",
    "dispatch-service": "./dist/service-cli.js",
    "dispatch-watch": "./dist/watch-cli.js"
  },
  "files": [
    "dist",
    "native",
    "scripts",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE",
    "AGENT-CHAT-LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "cron-parser": "5.4.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispatchlabs-ai/dispatch.git",
    "directory": "packages/runner"
  },
  "homepage": "https://github.com/dispatchlabs-ai/dispatch/tree/main/packages/runner#readme",
  "bugs": {
    "url": "https://github.com/dispatchlabs-ai/dispatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
