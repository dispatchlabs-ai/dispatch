{
  "name": "@dispatch/runner",
  "version": "0.6.0",
  "private": true,
  "description": "Standalone Pi Durable company agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./gmail": {
      "types": "./dist/gmail.d.ts",
      "import": "./dist/gmail.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "import": "./dist/gateway.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "dispatch-service": "./dist/service-cli.js"
  },
  "files": [
    "dist",
    "native",
    "scripts",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  }
}
