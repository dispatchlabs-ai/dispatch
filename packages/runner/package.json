{
  "name": "@dispatch/runner",
  "version": "0.7.0",
  "private": true,
  "description": "Standalone Pi Durable company agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1 <27"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  }
}
