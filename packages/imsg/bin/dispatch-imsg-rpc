#!/usr/bin/perl
use strict;
use warnings;
use Cwd qw(realpath);
use Fcntl qw(O_CREAT O_EXCL O_WRONLY O_RDONLY O_NOFOLLOW);
use File::Basename qw(basename);
use File::Temp qw(tempdir);
use IO::Handle;
use IO::Select;
use IPC::Open2;
use JSON::PP qw(decode_json encode_json);
use MIME::Base64 qw(decode_base64 encode_base64);

# imsg owns chat lookup and delivery. Read or stage attachments on its Mac.
@ARGV == 1 or die "Usage: dispatch-imsg-rpc /absolute/path/to/imsg\n";
my $dir = tempdir("dispatch-imsg-XXXXXXXX", TMPDIR => 1, CLEANUP => 1);
my $pid = open2(my $out, my $in, $ARGV[0], "rpc");
binmode($_, ":raw") for (\*STDIN, \*STDOUT, $in, $out);
STDOUT->autoflush(1);
$in->autoflush(1);
$SIG{TERM} = $SIG{HUP} = sub { die "Messages connection closed\n" };
$SIG{PIPE} = "IGNORE";

sub stage {
    my ($method, $params) = @_;
    my $name = $params->{name} // "";
    $name =~ /\ATable-[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}\.png\z/ or die "Invalid table filename";
    my $path = "$dir/$name";
    if ($method eq "dispatch.attachments.remove") {
        unlink($path) or die "Cannot remove staged table" if -e $path;
        return {};
    }
    my $encoded = $params->{png} // "";
    my $data = decode_base64($encoded);
    substr($data, 0, 8) eq "\x89PNG\r\n\x1a\n" && encode_base64($data, "") eq $encoded or die "Invalid PNG";
    if (-e $path) {
        open(my $old, "<:raw", $path) or die "Cannot read staged table";
        local $/;
        $data eq <$old> or die "Conflicting staged table";
    } else {
        sysopen(my $file, $path, O_WRONLY | O_CREAT | O_EXCL, 0600) or die "Cannot stage table";
        binmode($file);
        unless (print({$file} $data) && close($file)) { unlink($path); die "Cannot write staged table"; }
    }
    return {file => $path};
}

sub image_file {
    my ($attachment, $name) = @_;
    my $path = $attachment->{original_path} || $attachment->{filename} || "";
    $path =~ s{\A~/}{$ENV{HOME}/};
    my $root = realpath("$ENV{HOME}/Library/Messages/Attachments");
    $path = realpath($path);
    return unless defined($root) && defined($path) && index($path, "$root/") == 0 && -f $path;
    sysopen(my $file, $path, O_RDONLY | O_NOFOLLOW) or return;
    binmode($file);
    read($file, my $header, 12) or return;
    my $mime = substr($header, 0, 8) eq "\x89PNG\r\n\x1a\n" ? "image/png"
        : substr($header, 0, 3) eq "\xff\xd8\xff" ? "image/jpeg"
        : $header =~ /\ARIFF....WEBP/s ? "image/webp" : undef;
    my $data;
    if ($mime) {
        local $/;
        $data = $header . (<$file> // "");
    } else {
        # Camera photos and other ImageIO formats need a model-readable still.
        return unless ($attachment->{mime_type} // "") =~ m{\Aimage/}i
            || $name =~ /\.(?:heic|heif|gif|tiff?|avif|bmp)\z/i;
        my $tmp = File::Temp->new(TEMPLATE => "image-XXXXXXXX", DIR => $dir, SUFFIX => ".png");
        my $outpath = $tmp->filename;
        close($tmp);
        open(my $sips, "-|", "/usr/bin/sips", "-s", "format", "png", $path, "--out", $outpath) or return;
        1 while <$sips>;
        my $ok = close($sips);
        if ($ok && open(my $png, "<:raw", $outpath)) { local $/; $data = <$png>; }
        return unless defined($data) && substr($data, 0, 8) eq "\x89PNG\r\n\x1a\n";
        $name =~ s/\.[^.]+\z//;
        $name .= ".png";
        $mime = "image/png";
    }
    return { name => $name, mimeType => $mime, data => encode_base64($data, "") };
}

# Resolve by incoming message identity, never a caller-supplied filesystem path.
sub incoming {
    my ($request, $result) = @_;
    my $row = $result->{messages}[0];
    ref($row) eq "HASH" && defined($row->{is_from_me}) && !$row->{is_from_me}
        && $row->{id} == $request->{row_id} && $row->{chat_id} == $request->{chat_id}
        && $row->{guid} eq $request->{guid} or die "Incoming message no longer matches";
    my (@files, @unavailable);
    for my $attachment (@{$row->{attachments} // []}) {
        my $name = basename($attachment->{transfer_name} || $attachment->{filename} || "Attachment");
        my $image = image_file($attachment, $name);
        if ($image) { push @files, $image; } else { push @unavailable, $name; }
    }
    return {files => \@files, unavailable => \@unavailable};
}

my $reads = IO::Select->new(\*STDIN, $out);
my (%buffers, %lookups);
LOOP: while (my @ready = $reads->can_read) {
    for my $handle (@ready) {
        my $fd = fileno($handle);
        my $client = $fd == fileno(STDIN);
        my $count = sysread($handle, my $bytes, 65536);
        defined $count or die "Cannot read Messages RPC";
        unless ($count) {
            last LOOP unless $client;
            $reads->remove($handle);
            close($in);
            next;
        }
        $buffers{$fd} .= $bytes;
        while ((my $end = index($buffers{$fd}, "\n")) >= 0) {
            my $line = substr($buffers{$fd}, 0, $end + 1, "");
            my $packet = eval { decode_json($line) };
            if ($client) {
                my $method = ref($packet) eq "HASH" ? $packet->{method} // "" : "";
                if ($method eq "dispatch.attachments.put" || $method eq "dispatch.attachments.remove") {
                    my $reply = {jsonrpc => "2.0", id => $packet->{id}};
                    $reply->{result} = eval { stage($method, $packet->{params}) };
                    if ($@) { delete $reply->{result}; $reply->{error} = {code => -32602, message => "Could not stage or remove the table PNG"}; }
                    print STDOUT encode_json($reply), "\n" or last LOOP;
                } elsif ($method eq "dispatch.attachments.read") {
                    my $p = $packet->{params};
                    unless (ref($p) eq "HASH" && ($p->{row_id} // "") =~ /\A[1-9][0-9]*\z/
                        && ($p->{chat_id} // "") =~ /\A[1-9][0-9]*\z/ && length($p->{guid} // "")) {
                        print STDOUT encode_json({jsonrpc => "2.0", id => $packet->{id},
                            error => {code => -32602, message => "Expected incoming message identity"}}), "\n" or last LOOP;
                        next;
                    }
                    $lookups{$packet->{id}} = $p;
                    print {$in} encode_json({jsonrpc => "2.0", id => $packet->{id}, method => "messages.after",
                        params => {since_rowid => $p->{row_id} - 1, chat_id => $p->{chat_id}, limit => 1,
                            attachments => JSON::PP::true}}), "\n" or last LOOP;
                } else {
                    print {$in} $line or last LOOP;
                }
            } else {
                my $result = ref($packet) eq "HASH" ? $packet->{result} : undef;
                my $lookup = defined($packet->{id}) ? delete $lookups{$packet->{id}} : undef;
                if ($lookup && !$packet->{error}) {
                    $packet->{result} = eval { incoming($lookup, $result) };
                    if ($@) { delete $packet->{result}; $packet->{error} = {code => -32004, message => "Incoming message unavailable"}; }
                    $line = encode_json($packet) . "\n";
                } elsif (ref($result) eq "HASH" && exists($result->{protocol_version}) && ref($result->{methods}) eq "ARRAY") {
                    push @{$result->{methods}}, "dispatch.attachments.put", "dispatch.attachments.remove", "dispatch.attachments.read";
                    $line = encode_json($packet) . "\n";
                }
                print STDOUT $line or last LOOP;
            }
        }
    }
}
close($in) if defined fileno($in);
waitpid($pid, 0);
