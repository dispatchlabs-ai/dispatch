{
  "name": "@dispatch/imsg",
  "version": "0.25.1",
  "description": "Apple Messages transport for Dispatch Runner",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/dispatch-imsg-rpc",
    "dist",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": { "dispatch-imsg-rpc": "./bin/dispatch-imsg-rpc" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "npm run build --workspace @dispatch/runner",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@napi-rs/canvas": "1.1.1",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@dispatch/runner": "0.25.1",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispatchlabs-ai/dispatch.git",
    "directory": "packages/imsg"
  },
  "homepage": "https://github.com/dispatchlabs-ai/dispatch/tree/main/packages/imsg#readme",
  "bugs": {
    "url": "https://github.com/dispatchlabs-ai/dispatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
