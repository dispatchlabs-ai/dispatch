{
  "name": "@dispatch/workers",
  "version": "0.12.1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dispatch/runner": "0.12.1",
    "@dispatch/remote": "0.12.1",
    "@dispatch/backend": "0.12.1",
    "@earendil-works/pi-ai": "1.5.2",
    "ws": "8.22.0",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.1",
    "@types/pg": "8.15.5",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3"
  },
  "bin": {
    "dispatch-worker": "./dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispatchlabs-ai/dispatch.git",
    "directory": "packages/workers"
  },
  "homepage": "https://github.com/dispatchlabs-ai/dispatch/tree/main/packages/workers#readme",
  "bugs": {
    "url": "https://github.com/dispatchlabs-ai/dispatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Outbound-connected native Runner owners for Dispatch central services"
}
