    "@types/html-to-text": "9.0.4",
    "@types/markdown-it": "14.2.0",
    "@types/nodemailer": "8.0.2",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@dispatch/runner": "0.16.1",
    "@earendil-works/pi-durable": "1.5.2",
