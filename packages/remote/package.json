{
  "name": "@dispatch/remote",
  "version": "0.15.1",
  "description": "Relay transport and optional remote SQLite storage for Pi Durable runners",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "proper-lockfile": "4.1.2",
    "ws": "8.22.0",
    "@types/ws": "8.18.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispatchlabs-ai/dispatch.git",
    "directory": "packages/remote"
  },
  "homepage": "https://github.com/dispatchlabs-ai/dispatch/tree/main/packages/remote#readme",
  "bugs": {
    "url": "https://github.com/dispatchlabs-ai/dispatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
