{
  "name": "@dispatch/eval",
  "version": "0.16.1",
  "private": true,
  "description": "Evaluation of Pi Durable agents: a read-only native record reader, a grading loop and task, an engine with versioned append-only history, and one launcher",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    "./records": "./src/records.ts",
    "./grading": "./src/grading.ts",
    "./task": "./src/task.ts"
  },
  "scripts": {
    "build": "node scripts/check-content.mjs",
    "pretypecheck": "npm run build --workspace @dispatch/runner",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@dispatch/runner": "0.16.1",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@types/node": "24.19.1",
    "typescript": "6.0.3"
  }
}
