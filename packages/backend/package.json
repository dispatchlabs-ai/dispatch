{
  "name": "@dispatch/backend",
  "version": "0.15.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./central": {
      "types": "./dist/central.d.ts",
      "import": "./dist/central.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "USE_CASES.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENT-CHAT-LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dispatch/runner": "0.15.0",
    "@earendil-works/pi-ai": "1.5.2",
    "ws": "8.22.0",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.1",
    "@types/pg": "8.15.5",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dispatchlabs-ai/dispatch.git",
    "directory": "packages/backend"
  },
  "homepage": "https://github.com/dispatchlabs-ai/dispatch/tree/main/packages/backend#readme",
  "bugs": {
    "url": "https://github.com/dispatchlabs-ai/dispatch/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "Shared native chat operations and central service for Dispatch clients",
  "peerDependencies": {
    "@dispatch/remote": "0.15.0",
    "@dispatch/postgres": "0.15.0"
  },
  "peerDependenciesMeta": {
    "@dispatch/remote": {
      "optional": true
    },
    "@dispatch/postgres": {
      "optional": true
    }
  }
}
