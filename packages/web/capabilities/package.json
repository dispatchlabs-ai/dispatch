{
  "name": "@dispatch/pi-capabilities",
  "version": "0.2.0",
  "private": true,
  "description": "Host-installed native Dispatch extensions for Pi Durable 1.0.4",
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4"
  },
  "exports": {
    "./coding": {
      "types": "./build/extensions/coding.d.ts",
      "default": "./build/extensions/coding.js"
    },
    "./skills": {
      "types": "./build/extensions/skills.d.ts",
      "default": "./build/extensions/skills.js"
    },
    "./web": {
      "types": "./build/extensions/web.d.ts",
      "default": "./build/extensions/web.js"
    },
    "./web-backend": {
      "types": "./build/web/types.d.ts",
      "default": "./build/web/types.js"
    },
    "./image-gen": {
      "types": "./build/extensions/image-gen.d.ts",
      "default": "./build/extensions/image-gen.js"
    }
  },
  "files": [
    "build/extensions/coding.js",
    "build/extensions/coding.d.ts",
    "build/extensions/skills.js",
    "build/extensions/skills.d.ts",
    "build/extensions/web.js",
    "build/extensions/web.d.ts",
    "build/web/types.js",
    "build/web/types.d.ts",
    "build/extensions/image-gen.js",
    "build/extensions/image-gen.d.ts"
  ]
}
