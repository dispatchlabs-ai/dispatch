# Copy to .env next to compose.yaml.
# Controller image for your platform (linux/amd64 on most Windows PCs).
# Use a verified registry digest, or dispatch-web:873a54eb7c1f after loading the checksum-verified 0.4.0 archive.
# See README.md for the exact public registry digests and archive-loading instructions.
DISPATCH_IMAGE=
# Host port; Dispatch opens at http://localhost:<port>.
DISPATCH_PORT=3001
DISPATCH_COMPANY_NAME=Dispatch
