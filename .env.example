# Copy to .env next to compose.yaml.
# Controller image for your platform (linux/amd64 on most Windows PCs).
# Use a verified registry digest, or dispatch-web:0.3.0 after loading the checksum-verified 0.3.0 archive.
# The 0.3.0 archive loads as dispatch-web:uncommitted; retag it as described in README.md.
DISPATCH_IMAGE=
# Host port; Dispatch opens at http://localhost:<port>.
DISPATCH_PORT=3001
DISPATCH_COMPANY_NAME=Dispatch
