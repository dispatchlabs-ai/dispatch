# Copy to .env next to compose.yaml.
# Controller image for your platform (linux/amd64 on most Windows PCs).
# Use the inspected local tag after loading the checksum-verified controller archive, or a verified registry digest.
# See README.md for current image references and archive-loading instructions.
DISPATCH_IMAGE=
# Host port; Dispatch opens at http://localhost:<port>.
DISPATCH_PORT=3001
DISPATCH_COMPANY_NAME=Dispatch
