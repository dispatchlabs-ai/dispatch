{
  "name": "dispatch",
  "version": "0.17.2",
  "private": true,
  "workspaces": [
    "packages/runner",
    "packages/mcp",
    "packages/remote",
    "packages/postgres",
    "packages/backend",
    "packages/workers",
    "packages/slack",
    "packages/google-chat",
    "packages/email",
    "packages/fleet",
    "packages/observer",
    "packages/eval",
    "packages/web"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "npm run build --workspaces",
    "preview": "npm start --workspace @dispatch/web",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run typecheck && npm run build",
    "start": "npm start --workspace @dispatch/web",
    "release": "tsx scripts/release.ts",
    "pack:packages": "node scripts/pack-packages.mjs"
  },
  "type": "module"
}
